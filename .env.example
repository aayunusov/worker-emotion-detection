# Token from @BotFather. Never commit the real .env file.
TELEGRAM_BOT_TOKEN=

# Where face photos are written. Default: <this repo>/dataset
# Use another disk if you want, for example:
# DATASET_DIR=/media/usb/uzbek-fer
DATASET_DIR=dataset

# Optional. Your own numeric Telegram id, from @userinfobot.
# If set, /stats in the bot replies only to you.
OWNER_TELEGRAM_ID=
